+void DiscountedCfrTrainable::setEvs(const vector<float>& evs) {
+    this->evs = evs;
+}
+
+json DiscountedCfrTrainable::dump_evs() {
+    if(this->evs.empty()) return json();
+    json evs_map;
+    for(int i = 0;i < this->card_number;i ++){
+        vector<float> one_ev(this->action_number);
+        for(int j = 0;j < this->action_number;j ++) one_ev[j] = this->evs[j * this->card_number + i];
+        evs_map[(*this->privateCards)[i].toString()] = one_ev;
+    }
+    vector<string> actions_str;
+    for(GameActions& one_action:action_node.getActions()) actions_str.push_back(one_action.toString());
+    json retjson;
+    retjson["actions"] = std::move(actions_str);
+    retjson["evs"] = std::move(evs_map);
+    return retjson;
+}
+
 Trainable::TrainableType DiscountedCfrTrainable::get_type() {
     return DISCOUNTED_CFR_TRAINABLE;
 }
